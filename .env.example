# Copy to .env and fill from a logged-in x.com browser session (README - Credentials)
# Required (both):
X_AUTH_TOKEN=
X_CT0=
# Optional overrides:
# X_COOKIE=          # full Cookie header verbatim (needed only when Cloudflare challenges; must include cf_clearance)
# X_BEARER=          # public web bearer; default is current, rarely needs changing
# X_TXIDS=           # JSON {operation: x-client-transaction-id} from a capture - written to .env.fresh by make refresh
# X_USER_AGENT=      # should match the browser the cookies were captured from
# X_API_BASE=https://x.com/i/api
# X_TIMEOUT=20
